{
  "name": "family-shop-api",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create family-shop",
    "db:migrate:local": "wrangler d1 execute family-shop --local --file=schema.sql",
    "db:migrate": "wrangler d1 execute family-shop --remote --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute family-shop --remote --file=schema.sql",
    "db:migrate:learning": "wrangler d1 execute family-shop --remote --file=schema-learning.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250317.0",
    "typescript": "^5.8.2",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2"
  }
}
