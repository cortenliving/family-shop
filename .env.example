# Optional: Cloudflare Worker API base URL (no trailing slash)
# Leave empty for local-only mode (IndexedDB + multi-tab BroadcastChannel)
VITE_API_URL=https://family-shop-api.YOUR_SUBDOMAIN.workers.dev

# Web Push (public only — never put the private key in the frontend)
# Generate: cd worker && npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
